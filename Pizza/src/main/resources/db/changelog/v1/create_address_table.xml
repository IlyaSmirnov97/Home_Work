<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="1" author="Ilya">
        <createTable tableName="address">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="street" type="varchar(250)">
                <constraints nullable="false"/>
            </column>
            <column name="city" type="varchar(250)">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="varchar(250)">
                <constraints nullable="false"/>
            </column>
            <column name="postal_code" type="varchar(250)">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="varchar(250)">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>